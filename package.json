{
  "name": "finmate-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @finmate/web",
    "dev:admin": "npm run dev -w @finmate/admin",
    "build:web": "npm run build -w @finmate/web",
    "build:admin": "npm run build -w @finmate/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @finmate/db",
    "db:migrate": "npm run migrate -w @finmate/db",
    "db:deploy": "npm run deploy -w @finmate/db",
    "db:studio": "npm run studio -w @finmate/db",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "sync:fetch": "powershell -ExecutionPolicy Bypass -File scripts/sync-lovable.ps1 fetch",
    "sync:diff": "powershell -ExecutionPolicy Bypass -File scripts/sync-lovable.ps1 diff",
    "sync:files": "powershell -ExecutionPolicy Bypass -File scripts/sync-lovable.ps1 files"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
