# ────────────────────────────────────────────────────────────────
# Local development
# ────────────────────────────────────────────────────────────────
# docker-compose.yml-н Postgres хэрэглэх бол:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"

# Auth.js v5 — заавал санамсаргүй secret үүсгэх:
#   openssl rand -hex 32
AUTH_SECRET="replace-with-32-byte-random-hex"

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend email API key — имэйл баталгаажуулалтад хэрэглэнэ (https://resend.com)
RESEND_API_KEY="re_..."
# Илгээх хаяг (заавал биш, default: onboarding@resend.dev)
# MAIL_FROM="Finance Analytics <noreply@yourdomain.com>"

# Local dev үед database цэвэрлэхээс зайлсхийх (production-д заавал "1"):
DISABLE_DB_RESET="0"


# ────────────────────────────────────────────────────────────────
# Railway production env vars (Railway dashboard-д тохируулна)
# ────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:...@...railway.internal:5432/railway
# AUTH_SECRET=<32-byte hex>
# AUTH_URL=https://your-app.up.railway.app
# AUTH_TRUST_HOST=true
# ANTHROPIC_API_KEY=sk-ant-...
# RESEND_API_KEY=re_...
# MAIL_FROM=Finance Analytics <noreply@yourdomain.com>
# DISABLE_DB_RESET=1
# NODE_ENV=production
